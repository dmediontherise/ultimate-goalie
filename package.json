{
  "name": "ultimate-goalie",
  "homepage": "https://dmediontherise.github.io/ultimate-goalie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "rd /s /q docs",
    "predeploy": "npm run clean && npm run build",
    "deploy": "gh-pages -d docs",
    "test": "vitest run --reporter=basic",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup:browser": "playwright install chromium && ./scripts/install-browser-deps.sh"
  },
  "dependencies": {
    "@google/genai": "^0.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "gh-pages": "^6.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^4.0.0",
    "vitest": "^0.34.6"
  }
}
